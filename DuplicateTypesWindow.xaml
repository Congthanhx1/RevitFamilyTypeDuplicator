<Window x:Class="CopyFam.DuplicateTypesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy và đặt tên Family Type" Width="560" Height="510"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <TextBlock x:Name="LanguageLabel" Text="Ngôn ngữ" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox x:Name="LanguageCombo" Width="120" Height="28" SelectionChanged="LanguageChanged">
        <ComboBoxItem Content="Tiếng Việt" Tag="vi" IsSelected="True"/>
        <ComboBoxItem Content="English" Tag="en"/>
      </ComboBox>
    </StackPanel>
    <TextBlock x:Name="FilterHeading" Grid.Row="1" Text="Bộ lọc Family Type" FontWeight="SemiBold" Margin="0,10,0,0"/>
    <CheckBox x:Name="SelectedFamilyOnlyBox" Grid.Row="2" Margin="0,8,0,10"
              Content="Chỉ hiện Family của đối tượng đang chọn" Checked="FilterChanged" Unchecked="FilterChanged"/>
    <TextBlock x:Name="CategoryLabel" Grid.Row="3" Text="Category"/>
    <ComboBox x:Name="CategoryCombo" Grid.Row="4" Margin="0,6,0,10" Height="30" SelectionChanged="CategoryChanged"/>
    <TextBlock x:Name="FamilyLabel" Grid.Row="5" Text="Family"/>
    <ComboBox x:Name="FamilyCombo" Grid.Row="6" Margin="0,6,0,10" Height="30" SelectionChanged="FamilyChanged"/>
    <TextBlock x:Name="SourceLabel" Grid.Row="7" Text="Type nguồn"/>
    <ComboBox x:Name="SourceCombo" Grid.Row="8" Margin="0,6,0,15" Height="30"
              DisplayMemberPath="TypeName" SelectionChanged="SourceChanged"/>
    <Grid Grid.Row="9">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Name="PrefixLabel" Text="Tên gốc"/><TextBox x:Name="PrefixBox" Height="30" Margin="0,7,0,0"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock x:Name="StartLabel" Text="Từ số"/><TextBox x:Name="StartBox" Height="30" Margin="0,7,0,0" Text="1"/></StackPanel>
      <StackPanel Grid.Column="4"><TextBlock x:Name="EndLabel" Text="Đến số"/><TextBox x:Name="EndBox" Height="30" Margin="0,7,0,0" Text="6"/></StackPanel>
    </Grid>
    <TextBlock Grid.Row="10" x:Name="PreviewText" Margin="0,18,0,0" Foreground="#555" TextWrapping="Wrap"/>
    <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="Hủy" Width="90" Height="32" Margin="0,0,10,0" IsCancel="True"/>
      <Button x:Name="CreateButton" Content="Tạo Type" Width="100" Height="32" IsDefault="True" Click="CreateClicked"/>
    </StackPanel>
  </Grid>
</Window>
